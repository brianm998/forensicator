#!/usr/bin/env perl
use strict;
use warnings;
use 5.014;
use FindBin;
use lib "$FindBin::RealBin/../lib";

use Forensicator qw(
    open_catalog upsert_volume volumes
    json_encode json_decode jsonl_reader jsonl_writer
    os_name
);
use Getopt::Long qw(:config posix_default no_ignore_case);

my %opt = (
    output       => undef,
    rehash_list  => undef,
    dataset      => undef,
    quiet        => 0,
);
my @inputs;

GetOptions(\%opt,
    'output=s',
    'inputs=s{,}'    => \@inputs,
    'rehash-list=s'  => \$opt{rehash_list},
    'dataset=s'      => \$opt{dataset},
    'quiet|q'        => \$opt{quiet},
    'help|h' => \&usage,
) or die "see --help\n";

sub usage {
    print <<'EOF';
forensicator-merge: combine multiple catalogs/JSONL into one catalog or JSONL

Usage:
  forensicator-merge --output combined.sqlite --inputs a.sqlite b.sqlite ...
  forensicator-merge --output export.jsonl    --inputs combined.sqlite
  forensicator-merge --output combined.sqlite --inputs *.sqlite \
                     --rehash-list rehash-tasks.jsonl

Options:
  --output FILE        Output catalog (.sqlite) or export (.jsonl)
  --inputs FILE...     One or more inputs (.sqlite or .jsonl)
  --rehash-list FILE   When merging, write JSONL of files that need hashes
                       (size collisions across the merged set with NULL sha512)
  --dataset NAME       Dataset label for output catalog metadata
  --quiet              Suppress progress output

When (hostname, volume, path) appears in multiple inputs, the row with the
latest scanned_at wins. If hashes disagree the latest scan also wins, but a
warning is emitted.
EOF
    exit 0;
}

die "missing --output\n" unless $opt{output};
die "missing --inputs\n" unless @inputs;

my $out_kind = $opt{output} =~ /\.jsonl$/i ? 'jsonl' : 'sqlite';

if ($out_kind eq 'jsonl' && $opt{rehash_list}) {
    warn "[merge] note: --rehash-list with JSONL output uses an in-memory pass\n";
}

if ($out_kind eq 'sqlite') {
    die "refusing to overwrite existing output: $opt{output}\n" if -e $opt{output};
}

my $log = sub { warn "[merge] $_[0]\n" unless $opt{quiet} };

my $out_dbh;
my ($jsonl_emit, $jsonl_close);

if ($out_kind eq 'sqlite') {
    $out_dbh = open_catalog($opt{output}, dataset => $opt{dataset});
} else {
    ($jsonl_emit, $jsonl_close) = jsonl_writer($opt{output});
}

my %vol_id_cache;
sub volume_id {
    my ($hostname, $volume, $mount, $os) = @_;
    my $k = "$hostname\0$volume";
    return $vol_id_cache{$k} if $vol_id_cache{$k};
    my $v = upsert_volume($out_dbh,
        hostname    => $hostname,
        volume      => $volume,
        mount_point => $mount,
        os          => $os,
    );
    return $vol_id_cache{$k} = $v->{volume_id};
}

my $total_rows = 0;
my $total_conflicts = 0;
my $total_hash_disagreements = 0;

my $upsert_sth;
if ($out_dbh) {
    $upsert_sth = $out_dbh->prepare(<<'SQL');
INSERT INTO files(volume_id, path, path_norm, size, mtime, sha512, scanned_at)
VALUES(?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(volume_id, path_norm) DO UPDATE SET
  path       = CASE WHEN excluded.scanned_at >= files.scanned_at
                    THEN excluded.path ELSE files.path END,
  size       = CASE WHEN excluded.scanned_at >= files.scanned_at
                    THEN excluded.size ELSE files.size END,
  mtime      = CASE WHEN excluded.scanned_at >= files.scanned_at
                    THEN excluded.mtime ELSE files.mtime END,
  sha512     = CASE
                 WHEN excluded.scanned_at >= files.scanned_at AND excluded.sha512 IS NOT NULL
                   THEN excluded.sha512
                 WHEN files.sha512 IS NULL
                   THEN excluded.sha512
                 ELSE files.sha512
               END,
  scanned_at = MAX(excluded.scanned_at, files.scanned_at)
SQL
}

my $check_sth;
if ($out_dbh) {
    $check_sth = $out_dbh->prepare(<<'SQL');
SELECT size, sha512, scanned_at FROM files WHERE volume_id = ? AND path_norm = ?
SQL
}

$out_dbh->begin_work if $out_dbh;

for my $input (@inputs) {
    if ($input =~ /\.jsonl$/i) {
        ingest_jsonl($input);
    } elsif ($input =~ /\.sqlite$/i || $input =~ /\.db$/i) {
        ingest_sqlite($input);
    } else {
        if (-e $input) {
            open my $fh, '<:raw', $input or die "$input: $!\n";
            read $fh, my $head, 16;
            close $fh;
            if (defined $head && $head =~ /^SQLite format 3/) {
                ingest_sqlite($input);
            } else {
                ingest_jsonl($input);
            }
        } else {
            die "no such input: $input\n";
        }
    }
}

$out_dbh->commit if $out_dbh;
$jsonl_close->() if $jsonl_close;

$log->("merged $total_rows rows from " . scalar(@inputs) . " inputs");
$log->("$total_conflicts duplicate (host,volume,path) rows reconciled") if $total_conflicts;
$log->("$total_hash_disagreements rows had disagreeing SHA512 (newest scan kept)")
    if $total_hash_disagreements;

if ($opt{rehash_list} && $out_dbh) {
    write_rehash_list($out_dbh, $opt{rehash_list});
}

$out_dbh->disconnect if $out_dbh;
exit 0;

# --- ingest ---

sub ingest_sqlite {
    my $path = shift;
    $log->("ingesting sqlite: $path");
    my $in = open_catalog($path, readonly => 1);
    my $vols = volumes($in);
    my $count = 0;
    for my $v (@$vols) {
        my $sth = $in->prepare(<<'SQL');
SELECT path, path_norm, size, mtime, sha512, scanned_at
FROM files WHERE volume_id = ?
SQL
        $sth->execute($v->{volume_id});
        while (my $row = $sth->fetchrow_hashref) {
            ingest_row({
                hostname    => $v->{hostname},
                volume      => $v->{volume},
                mount_point => $v->{mount_point},
                os          => $v->{os},
                path        => $row->{path},
                path_norm   => $row->{path_norm},
                size        => $row->{size},
                mtime       => $row->{mtime},
                sha512      => $row->{sha512},
                scanned_at  => $row->{scanned_at},
            });
            $count++;
            if ($out_dbh && $count % 5000 == 0) {
                $out_dbh->commit; $out_dbh->begin_work;
            }
        }
    }
    $in->disconnect;
    $log->("  $count rows from $path");
}

sub ingest_jsonl {
    my $path = shift;
    $log->("ingesting jsonl: $path");
    my $reader = jsonl_reader($path);
    my $count = 0;
    while (my $row = $reader->()) {
        next unless ref $row eq 'HASH' && %$row;
        next unless defined $row->{hostname} && defined $row->{volume} && defined $row->{path};
        $row->{path_norm}  //= Forensicator::normalize_path($row->{path}, $row->{os});
        $row->{scanned_at} //= time;
        $row->{mtime}      //= 0;
        $row->{size}       //= 0;
        ingest_row($row);
        $count++;
        if ($out_dbh && $count % 5000 == 0) {
            $out_dbh->commit; $out_dbh->begin_work;
        }
    }
    $log->("  $count rows from $path");
}

sub ingest_row {
    my $row = shift;
    $total_rows++;
    if ($out_dbh) {
        my $vid = volume_id(
            $row->{hostname}, $row->{volume},
            $row->{mount_point}, $row->{os},
        );

        $check_sth->execute($vid, $row->{path_norm});
        my $existing = $check_sth->fetchrow_hashref;
        $check_sth->finish;
        if ($existing) {
            $total_conflicts++;
            if (defined $existing->{sha512} && defined $row->{sha512}
                && $existing->{sha512} ne $row->{sha512})
            {
                $total_hash_disagreements++;
                warn sprintf("[merge] hash disagreement on %s:%s:%s\n",
                    $row->{hostname}, $row->{volume}, $row->{path}) unless $opt{quiet};
            }
        }
        $upsert_sth->execute(
            $vid,
            $row->{path}, $row->{path_norm},
            $row->{size}, $row->{mtime},
            $row->{sha512}, $row->{scanned_at},
        );
    } else {
        $jsonl_emit->({
            hostname    => $row->{hostname},
            volume      => $row->{volume},
            mount_point => $row->{mount_point},
            os          => $row->{os},
            path        => $row->{path},
            path_norm   => $row->{path_norm},
            size        => $row->{size} + 0,
            mtime       => $row->{mtime} + 0,
            sha512      => $row->{sha512},
            scanned_at  => $row->{scanned_at} + 0,
        });
    }
}

sub write_rehash_list {
    my ($dbh, $path) = @_;
    $log->("writing rehash list: $path");
    my $rows = $dbh->selectall_arrayref(<<'SQL', { Slice => {} });
SELECT v.hostname, v.volume, v.mount_point, f.path, f.path_norm, f.size
FROM files f
JOIN volumes v ON v.volume_id = f.volume_id
WHERE f.sha512 IS NULL
  AND f.size IN (
    SELECT size FROM files GROUP BY size HAVING COUNT(*) > 1
  )
ORDER BY v.hostname, v.volume, f.path_norm
SQL
    my ($emit, $close) = jsonl_writer($path);
    my $n = 0;
    for my $r (@$rows) {
        $emit->({
            hostname    => $r->{hostname},
            volume      => $r->{volume},
            mount_point => $r->{mount_point},
            path        => $r->{path},
            path_norm   => $r->{path_norm},
            size        => $r->{size} + 0,
        });
        $n++;
    }
    $close->();
    $log->("rehash list: $n entries");
}
